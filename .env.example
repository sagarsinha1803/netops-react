# Copy to .env and edit. Loaded automatically (python-dotenv).

# ---- which model backend -----------------------------------------------------
# clipboard = human relay (paste into Copilot)
# api       = OpenAI-compatible endpoint at LLM_BASE_URL
LLM_MODE=clipboard

# ---- clipboard relay style (only used when LLM_MODE=clipboard) --------------
# agent = instructions + tool list already pasted into a custom M365 Copilot
#         agent -> pastes carry only the new question / tool result (shortest)
# delta = one normal Copilot chat, only new messages pasted
# full  = every paste self-contained (fresh chat each time)
CLIP_MODE=delta

# ---- api mode settings (ignored unless LLM_MODE=api) ------------------------
# Any OpenAI-compatible endpoint. The base URL must end in /v1 for a plain
# vLLM server; GitHub Models is the exception and takes no /v1 suffix.
#
#   self-hosted vLLM   LLM_BASE_URL=http://vllm-host:8000/v1
#                      LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
#                      LLM_API_KEY=<whatever --api-key vLLM was started with>
#
#   GitHub Models      LLM_BASE_URL=https://models.github.ai/inference
#                      LLM_MODEL=openai/gpt-4o
#                      LLM_API_KEY=<GitHub PAT with the models:read scope>
#
# The model must support TOOL CALLING -- the agent chooses its commands through
# tool calls, and a model without it will answer in prose and run nothing. For
# vLLM that means starting the server with --enable-auto-tool-choice and the
# right --tool-call-parser for the model.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gpt-4o
# A credential -- keep it here or in the environment, never in the code.
# OPENAI_API_KEY and GITHUB_TOKEN are read as fallbacks.
LLM_API_KEY=EMPTY
# Seconds to wait for one completion. Raise it for a slow/reasoning model.
LLM_TIMEOUT=600

# ---- masking -----------------------------------------------------------------
# 1 = real values never leave this machine. Stand-ins go on the clipboard and
#     are swapped back before anything is validated, approved or executed, so
#     the device, the approval prompt and the report all see reality.
#     Covers IPv4, IPv6 and MAC addresses. Turning this off disables ALL
#     masking, names included.
MASK_IPS=1

# ip    = 198.18.0.20   stand-in addresses (default; safest, because the model
#                       has to write valid CLI around them)
# label = ip4.n0.h20    obviously not an address; better for demonstrating that
#                       masking works, but the model may substitute an invented
#                       IP instead of using the label
MASK_STYLE=ip

# The IPv4 stand-in pool, used only by MASK_STYLE=ip. Must not exist on your
# network -- a real address inside it raises PoolCollision rather than
# mismapping. IPv6 uses 2001:db8::/32 and MACs the IANA documentation block.
MASK_POOL=198.18.0.0/15

# Hostnames, ACL names, VRF names, interface names, CMDB region and route
# distinguishers.
#   auto = on for the clipboard relay only (default). An API endpoint is inside
#          a boundary you already accepted, and stand-ins only degrade it.
#   1    = always on, whatever the backend
#   0    = off; addresses are still masked
MASK_NAMES=auto

# Not configurable: the CMDB credential redaction in mcp_tools/redact.py.
# Passwords have no business leaving the CMDB in any mode.

# ---- MCP ---------------------------------------------------------------------
# 1 = mock CMDB, mock devices and mock Tufin (tests/mocks); no network at all
USE_MOCKS=0
SSH_MCP_URL=http://ssh-mcp-host:4021/sse

# ---- chat history (Chainlit UI) ---------------------------------------------
# 1 = sidebar of past conversations and resume, 0 = stateless
CHAT_HISTORY=0
# No login screen. Chainlit still needs an identity to attach threads to, so
# every session runs as this local user. This is NOT access control - do not
# expose the port beyond your machine.
APP_USER=netops
